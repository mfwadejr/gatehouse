{
  "$description": "Gatehouse design tokens, extracted from the dashboard, settings and firewall mockups. Three layers: primitive (raw values, never used by components), semantic (roles components may use), component (sized parts built from semantic values). Dark is the default theme. The light theme under 'themes' is a DRAFT: its series colors come from the validated palette, but the rest is not yet contrast-checked.",

  "primitive": {
    "neutral": {
      "950": { "$value": "#0d0d0d" },
      "925": { "$value": "#121211" },
      "900": { "$value": "#1a1a19" },
      "800": { "$value": "#2c2c2a" },
      "700": { "$value": "#383835" },
      "500": { "$value": "#898781" },
      "300": { "$value": "#c3c2b7" },
      "100": { "$value": "#f0efec" },
      "0":   { "$value": "#ffffff" }
    },
    "neutral-light": {
      "25":  { "$value": "#fcfcfb" },
      "50":  { "$value": "#f9f9f7" },
      "100": { "$value": "#f3f2ee" },
      "200": { "$value": "#e1e0d9" },
      "300": { "$value": "#c3c2b7" },
      "500": { "$value": "#898781" },
      "600": { "$value": "#52514e" },
      "950": { "$value": "#0b0b0b" }
    },
    "blue": {
      "100": { "$value": "#cde2fb" },
      "150": { "$value": "#b7d3f6" },
      "200": { "$value": "#9ec5f4" },
      "250": { "$value": "#86b6ef" },
      "300": { "$value": "#6da7ec" },
      "350": { "$value": "#5598e7" },
      "400": { "$value": "#3987e5" },
      "450": { "$value": "#2a78d6" },
      "500": { "$value": "#256abf" },
      "550": { "$value": "#1c5cab" },
      "600": { "$value": "#184f95" },
      "650": { "$value": "#104281" },
      "700": { "$value": "#0d366b" }
    },
    "slate-blue": {
      "600": { "$value": "#384a6b" }
    },
    "hue-dark": {
      "blue":    { "$value": "#3987e5" },
      "orange":  { "$value": "#d95926" },
      "aqua":    { "$value": "#199e70" },
      "yellow":  { "$value": "#c98500" },
      "magenta": { "$value": "#d55181" },
      "green":   { "$value": "#008300" },
      "violet":  { "$value": "#9085e9" },
      "red":     { "$value": "#e66767" }
    },
    "hue-light": {
      "blue":    { "$value": "#2a78d6" },
      "orange":  { "$value": "#eb6834" },
      "aqua":    { "$value": "#1baf7a" },
      "yellow":  { "$value": "#eda100" },
      "magenta": { "$value": "#e87ba4" },
      "green":   { "$value": "#008300" },
      "violet":  { "$value": "#6250d6" },
      "red":     { "$value": "#e34948" }
    },
    "status": {
      "green":  { "$value": "#0ca30c" },
      "yellow": { "$value": "#fab219" },
      "coral":  { "$value": "#ec835a" },
      "red":    { "$value": "#d03b3b" }
    },
    "alpha": {
      "white-06":  { "$value": "rgba(255, 255, 255, 0.06)" },
      "white-10":  { "$value": "rgba(255, 255, 255, 0.10)" },
      "ink-06":    { "$value": "rgba(11, 11, 11, 0.06)" },
      "ink-10":    { "$value": "rgba(11, 11, 11, 0.10)" },
      "blue-12":   { "$value": "rgba(57, 135, 229, 0.12)" },
      "blue-16":   { "$value": "rgba(57, 135, 229, 0.16)" },
      "blue-30":   { "$value": "rgba(57, 135, 229, 0.30)" },
      "blue-50":   { "$value": "rgba(57, 135, 229, 0.50)" },
      "coral-45":  { "$value": "rgba(236, 131, 90, 0.45)" }
    }
  },

  "color": {
    "bg": {
      "page":    { "$value": "{primitive.neutral.950}", "$description": "Behind everything" },
      "sidebar": { "$value": "{primitive.neutral.925}" },
      "surface": { "$value": "{primitive.neutral.900}", "$description": "Cards and panels" },
      "inset":   { "$value": "{primitive.neutral.925}", "$description": "Inputs, table footers, wells inside a card" }
    },
    "border": {
      "default": { "$value": "{primitive.alpha.white-10}", "$description": "Card and control outlines" },
      "subtle":  { "$value": "{primitive.neutral.800}", "$description": "Row dividers, gridlines" },
      "strong":  { "$value": "{primitive.neutral.700}", "$description": "Input borders, chart axes" },
      "accent":  { "$value": "{primitive.slate-blue.600}", "$description": "Info banners" }
    },
    "text": {
      "primary":   { "$value": "{primitive.neutral.100}" },
      "secondary": { "$value": "{primitive.neutral.300}" },
      "muted":     { "$value": "{primitive.neutral.500}" },
      "link":      { "$value": "{primitive.blue.300}" },
      "on-accent": { "$value": "{primitive.neutral.0}" }
    },
    "accent": {
      "default":         { "$value": "{primitive.blue.450}", "$description": "Primary buttons, switches that are on" },
      "fill":            { "$value": "{primitive.blue.400}", "$description": "Bars, lines, meter fill" },
      "track":           { "$value": "{primitive.blue.700}", "$description": "Unfilled part of a meter" },
      "selected-bg":     { "$value": "{primitive.alpha.blue-16}" },
      "selected-border": { "$value": "{primitive.blue.400}" },
      "avatar-bg":       { "$value": "{primitive.blue.600}" }
    },
    "state": {
      "hover": { "$value": "{primitive.alpha.white-06}" }
    },
    "status": {
      "good":           { "$value": "{primitive.status.green}" },
      "warning":        { "$value": "{primitive.status.yellow}" },
      "serious":        { "$value": "{primitive.status.coral}" },
      "critical":       { "$value": "{primitive.status.red}" },
      "serious-border": { "$value": "{primitive.alpha.coral-45}" }
    },
    "control": {
      "switch-off":  { "$value": "{primitive.neutral.700}" },
      "switch-knob": { "$value": "{primitive.neutral.100}" }
    },
    "matrix": {
      "allow":          { "$value": "{primitive.alpha.blue-30}" },
      "limited":        { "$value": "{primitive.alpha.blue-12}" },
      "limited-border": { "$value": "{primitive.alpha.blue-50}" },
      "deny":           { "$value": "{primitive.neutral.925}" },
      "open-bg": { "$value": "rgba(47, 191, 113, 0.16)" },
      "open-border": { "$value": "rgba(47, 191, 113, 0.55)" },
      "open-text": { "$value": "#bff0d5" },
      "open-dot": { "$value": "#2fbf71" },
      "block-bg": { "$value": "rgba(229, 96, 77, 0.13)" },
      "block-border": { "$value": "rgba(229, 96, 77, 0.45)" },
      "block-text": { "$value": "#f3b8ae" },
      "block-dot": { "$value": "#e5604d" },
      "replies-bg": { "$value": "rgba(232, 178, 58, 0.15)" },
      "replies-border": { "$value": "rgba(232, 178, 58, 0.55)" },
      "replies-text": { "$value": "#f6dc9b" },
      "replies-dot": { "$value": "#e8b23a" },
      "deny-border":    { "$value": "{primitive.neutral.700}" }
    },
    "chart": {
      "series-1": { "$value": "{primitive.hue-dark.blue}" },
      "series-2": { "$value": "{primitive.hue-dark.orange}" },
      "series-3": { "$value": "{primitive.hue-dark.aqua}" },
      "series-4": { "$value": "{primitive.hue-dark.yellow}" },
      "series-5": { "$value": "{primitive.hue-dark.magenta}" },
      "series-6": { "$value": "{primitive.hue-dark.green}" },
      "series-7": { "$value": "{primitive.hue-dark.violet}" },
      "series-8": { "$value": "{primitive.hue-dark.red}" },
      "grid":     { "$value": "{primitive.neutral.800}" },
      "axis":     { "$value": "{primitive.neutral.700}" },
      "label":    { "$value": "{primitive.neutral.500}" },
      "track":    { "$value": "{primitive.neutral.800}", "$description": "Unfilled part of a single-colour bar" }
    }
  },

  "font": {
    "family": {
      "sans": { "$value": "system-ui, -apple-system, 'Segoe UI', sans-serif" },
      "mono": { "$value": "ui-monospace, Menlo, monospace" }
    },
    "size": {
      "xs":  { "$value": "11px" },
      "sm":  { "$value": "12px" },
      "base":{ "$value": "13px" },
      "md":  { "$value": "14px" },
      "lg":  { "$value": "15px" },
      "xl":  { "$value": "17px" },
      "2xl": { "$value": "22px" },
      "3xl": { "$value": "24px" },
      "4xl": { "$value": "26px" },
      "5xl": { "$value": "30px" }
    },
    "weight": {
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" }
    },
    "tracking": {
      "tight":   { "$value": "-0.01em" },
      "tighter": { "$value": "-0.02em" },
      "caps":    { "$value": "0.04em" }
    },
    "leading": {
      "normal": { "$value": "1.45" }
    }
  },

  "space": {
    "0-5": { "$value": "2px" },
    "1":   { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2":   { "$value": "8px" },
    "2-5": { "$value": "10px" },
    "3":   { "$value": "12px" },
    "3-5": { "$value": "14px" },
    "4":   { "$value": "16px" },
    "4-5": { "$value": "18px" },
    "5":   { "$value": "20px" },
    "6":   { "$value": "24px" },
    "7":   { "$value": "28px" },
    "8":   { "$value": "32px" },
    "12":  { "$value": "48px" }
  },

  "radius": {
    "xs":   { "$value": "3px" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "8px" },
    "lg":   { "$value": "10px" },
    "xl":   { "$value": "12px" },
    "full": { "$value": "9999px" }
  },

  "border": {
    "width": {
      "thin":  { "$value": "1px" },
      "thick": { "$value": "2px" }
    }
  },

  "size": {
    "sidebar-width":     { "$value": "232px" },
    "control-sm":        { "$value": "30px" },
    "control-md":        { "$value": "36px" },
    "control-lg":        { "$value": "38px" },
    "nav-item":          { "$value": "40px" },
    "tab-height":        { "$value": "40px" },
    "touch-target":      { "$value": "44px" },
    "avatar":            { "$value": "36px" },
    "icon-xs":           { "$value": "12px" },
    "icon-sm":           { "$value": "14px" },
    "icon-md":           { "$value": "16px" },
    "icon-lg":           { "$value": "18px" },
    "switch-width":      { "$value": "40px" },
    "switch-height":     { "$value": "22px" },
    "switch-knob":       { "$value": "16px" },
    "bar-thin":          { "$value": "5px" },
    "bar-md":            { "$value": "6px" },
    "bar-lg":            { "$value": "8px" },
    "bar-segment":       { "$value": "14px" },
    "bar-timeline":      { "$value": "16px" }
  },

  "chart": {
    "line-width":   { "$value": "2px" },
    "marker-radius":{ "$value": "4px" },
    "surface-ring": { "$value": "2px" },
    "area-opacity": { "$value": "0.10" }
  },

  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "z": {
    "dropdown": { "$value": "100" },
    "modal":    { "$value": "200" },
    "toast":    { "$value": "300" }
  },

  "component": {
    "card": {
      "padding":  { "$value": "{space.5}" },
      "radius":   { "$value": "{radius.xl}" },
      "gap":      { "$value": "{space.4}" }
    },
    "tile": {
      "padding-y": { "$value": "{space.4}" },
      "padding-x": { "$value": "{space.4-5}" }
    },
    "page": {
      "padding-x": { "$value": "{space.8}" },
      "padding-top": { "$value": "{space.6}" },
      "padding-bottom": { "$value": "{space.12}" },
      "gap": { "$value": "{space.5}" }
    },
    "button": {
      "height":  { "$value": "{size.control-md}" },
      "padding-x": { "$value": "{space.3-5}" },
      "radius":  { "$value": "{radius.md}" }
    },
    "input": {
      "height": { "$value": "{size.control-md}" },
      "radius": { "$value": "{radius.md}" },
      "padding-x": { "$value": "{space.3}" }
    },
    "table": {
      "row-padding-y": { "$value": "{space.3}" },
      "cell-gap": { "$value": "{space.3}" }
    }
  },

  "themes": {
    "light": {
      "color.bg.page":            "{primitive.neutral-light.50}",
      "color.bg.sidebar":         "{primitive.neutral-light.100}",
      "color.bg.surface":         "{primitive.neutral-light.25}",
      "color.bg.inset":           "{primitive.neutral-light.100}",
      "color.border.default":     "{primitive.alpha.ink-10}",
      "color.border.subtle":      "{primitive.neutral-light.200}",
      "color.border.strong":      "{primitive.neutral-light.300}",
      "color.text.primary":       "{primitive.neutral-light.950}",
      "color.text.secondary":     "{primitive.neutral-light.600}",
      "color.text.muted":         "{primitive.neutral-light.500}",
      "color.text.link":          "{primitive.blue.500}",
      "color.state.hover":        "{primitive.alpha.ink-06}",
      "color.chart.series-1":     "{primitive.hue-light.blue}",
      "color.chart.series-2":     "{primitive.hue-light.orange}",
      "color.chart.series-3":     "{primitive.hue-light.aqua}",
      "color.chart.series-4":     "{primitive.hue-light.yellow}",
      "color.chart.series-5":     "{primitive.hue-light.magenta}",
      "color.chart.series-6":     "{primitive.hue-light.green}",
      "color.chart.series-7":     "{primitive.hue-light.violet}",
      "color.chart.series-8":     "{primitive.hue-light.red}",
      "color.chart.grid":         "{primitive.neutral-light.200}",
      "color.chart.axis":         "{primitive.neutral-light.300}",
      "color.chart.track":        "{primitive.neutral-light.200}",
      "color.control.switch-off": "{primitive.neutral-light.300}",
      "color.control.switch-knob":"{primitive.neutral-light.25}",
      "color.matrix.deny":        "{primitive.neutral-light.100}",
      "color.matrix.deny-border": "{primitive.neutral-light.300}",
      "color.matrix.open-bg": "rgba(31, 150, 85, 0.13)",
      "color.matrix.open-border": "#2a9d62",
      "color.matrix.open-text": "#0f5a33",
      "color.matrix.open-dot": "#1f9655",
      "color.matrix.block-bg": "rgba(205, 70, 50, 0.10)",
      "color.matrix.block-border": "#d46a5a",
      "color.matrix.block-text": "#8f2a1c",
      "color.matrix.block-dot": "#cd4632",
      "color.matrix.replies-bg": "rgba(214, 150, 20, 0.15)",
      "color.matrix.replies-border": "#c99014",
      "color.matrix.replies-text": "#6b4b00",
      "color.matrix.replies-dot": "#d69614",
      "color.accent.track":       "{primitive.blue.150}"
    }
  }
}
