# Until you set up your connections, every wired port asks for an address, so the console
# can be reached from whichever network the device was plugged into. Connections you
# configure in the console are written to gatehouse-*.network files, which take precedence.
[Match]
Name=en* eth* usb*
Type=ether

[Network]
DHCP=yes
LinkLocalAddressing=ipv4

[DHCPv4]
UseDNS=yes
RouteMetric=1000
