[Unit]
Description=Gatehouse (DNS, DHCP and web console)
ConditionKernelCommandLine=!boot=live
After=gatehouse-netd.service network.target
Requires=gatehouse-netd.service

[Service]
Type=simple
User=gatehouse
Group=gatehouse
ExecStart=/usr/local/bin/gatehouse daemon -data /var/lib/gatehouse -web :443 -dns :53 -dhcp :67
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gatehouse
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
