[Unit]
Description=NopeWarden (DNS, DHCP and web console)
ConditionKernelCommandLine=!boot=live
After=nopewarden-netd.service network.target
# Wants, not Requires: if the helper restarts, the console keeps running and the helper comes back on its own.
Wants=nopewarden-netd.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=nopewarden
Group=nopewarden
ExecStart=/usr/local/bin/nopewarden daemon -data /var/lib/nopewarden -web :443 -dns :53 -dhcp :67
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nopewarden -/run/nopewarden/ndpi
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
