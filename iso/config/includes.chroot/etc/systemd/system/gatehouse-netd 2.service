[Unit]
Description=Gatehouse network helper (firewall, interfaces, internet connections)
Documentation=https://github.com/
ConditionKernelCommandLine=!boot=live
After=local-fs.target
Before=network-pre.target gatehouse.service
Wants=network-pre.target

[Service]
Type=simple
RuntimeDirectory=gatehouse
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/gatehouse netd -uid 990 -group gatehouse
Restart=always
RestartSec=2
# The helper must be able to change the network, so it keeps root, but little else.
NoNewPrivileges=no
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
