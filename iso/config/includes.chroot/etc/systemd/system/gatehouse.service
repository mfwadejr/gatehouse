[Unit]
Description=Gatehouse (DNS, DHCP and web console)
ConditionKernelCommandLine=!boot=live
After=gatehouse-netd.service network.target
# Wants, not Requires: if the helper restarts, the console keeps running and the helper comes back on its own.
Wants=gatehouse-netd.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=gatehouse
Group=gatehouse
ExecStart=/usr/local/bin/gatehouse daemon -data /var/lib/gatehouse -web :443 -dns :53 -dhcp :67
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gatehouse -/run/gatehouse/ndpi
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
