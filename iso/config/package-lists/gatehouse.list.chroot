amd64-microcode

# Remote login: installed but switched off until the administrator turns it on in the console
openssh-server

# Convenience on the local console
nano
less

# Optional automatic Debian security updates (off until switched on in the console)
unattended-upgrades
debian-archive-keyring

# Names of network card makers on the Devices page (the IEEE registry, refreshed by Debian updates)
ieee-data
iputils-arping
